# ============================================================================
# Conversation Coaching App - environment configuration
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ============================================================================

# ---- Azure OpenAI Realtime (GA /openai/v1 protocol) ------------------------
# Base resource URL (discovered): the OpenAI resource is spelled "shhchat".
AZURE_OPENAI_ENDPOINT=https://shhchat.openai.azure.com
# The realtime DEPLOYMENT name (NOT the resource name, NOT the model name).
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1
# Auth: provide an API key OR leave blank to use Entra ID (DefaultAzureCredential).
AZURE_OPENAI_API_KEY=
# Entra token scope used when no API key is set.
AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default

# ---- Azure AI Search -------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://secondchat.search.windows.net
# The INDEX name (NOT the service name "secondchat"). No index exists yet;
# set this once an index is created.
AZURE_SEARCH_INDEX=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_API_VERSION=2024-07-01

# Field mappings: map your index's real field names onto these roles.
AZURE_SEARCH_ID_FIELD=id
AZURE_SEARCH_CONTENT_FIELD=content
AZURE_SEARCH_TITLE_FIELD=title
AZURE_SEARCH_URL_FIELD=url
# Optional: comma-separated fields to restrict keyword search to (blank = all).
AZURE_SEARCH_SEARCH_FIELDS=
AZURE_SEARCH_TOP=3

# ---- Hybrid search (keep OFF until a vectorizer/embedding is confirmed) ----
AZURE_SEARCH_USE_HYBRID=false
AZURE_SEARCH_VECTOR_FIELD=
# text-embedding-ada-002 is deployed on shhchat and can back hybrid later.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ---- Coaching response policy ----------------------------------------------
# Default: silent TEXT coaching. Set true for spoken responses.
COACH_SPOKEN_MODE=false
# Backend-driven grounding: keep auto-response OFF so answers require retrieval.
COACH_AUTO_RESPONSE=false
COACH_VOICE=marin

# ---- Privacy ----------------------------------------------------------------
# Audio/transcripts are not persisted by default.
COACH_PERSIST_TRANSCRIPTS=false

# ---- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
